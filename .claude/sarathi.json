{
  "kavach": { "python": "python3", "config": ".claude/kavach.json" },
  "forbidEnv": {
    "CLAUDE_CODE_DISABLE_ADVISOR_TOOL": "it turns the advisor off, and work in veda runs with the advisor on"
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit", "guard": "worktree" },
      { "matcher": "Bash", "guard": "command" }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|mcp__ccd_pr__set_monitor|mcp__ccd_pr__get_status|mcp__ccd_turn__wrap_up",
        "command": "bash \"$SARATHI_HOOKS\"/autofix-watch.sh",
        "timeout": 10
      }
    ],
    "PostToolUseFailure": [{ "matcher": "mcp__ccd_pr__set_monitor", "command": "bash \"$SARATHI_HOOKS\"/autofix-watch.sh", "timeout": 10 }]
  }
}
