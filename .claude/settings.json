{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "advisorModel": "fable",
  "permissions": {
    "allow": [
      "Edit(./**)",
      "Write(./**)",
      "NotebookEdit(./**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-remote:*)",
      "Bash(git worktree list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh issue list:*)",
      "Bash(git push -u origin:*)",
      "Bash(gh pr create --draft:*)",
      "Bash(gh pr ready:*)",
      "mcp__ccd_pr__bind_pr",
      "mcp__ccd_pr__get_status",
      "mcp__ccd_pr__set_monitor",
      "mcp__Claude_Browser__get_page_text",
      "mcp__Claude_Browser__tabs_context",
      "mcp__claude-code-remote__send_message"
    ],
    "deny": ["Bash(*--no-verify*)"],
    "ask": [
      "Bash(*git push*--force*)",
      "Bash(*git push* -f*)",
      "Bash(*git push*--for*)",
      "Bash(*git push*--mi*)",
      "Bash(*git push*--de*)",
      "Bash(*git push*--pru*)",
      "Bash(*git push* -d *)",
      "Bash(*git push* +*)",
      "Bash(*git push* :*)",
      "Bash(*git branch* -D*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm update:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm update:*)",
      "Bash(yarn add:*)",
      "Bash(yarn remove:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "v=$(printf '%s' \"${CLAUDE_CODE_DISABLE_ADVISOR_TOOL:-}\" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]'); case \"$v\" in ''|0|false) exit 0 ;; esac; echo 'CLAUDE_CODE_DISABLE_ADVISOR_TOOL is set, and work in veda runs with the advisor on. Unset it and start a new session; until then every edit and command is refused.'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "v=$(printf '%s' \"${CLAUDE_CODE_DISABLE_ADVISOR_TOOL:-}\" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]'); case \"$v\" in ''|0|false) exit 0 ;; esac; echo 'BLOCKED: CLAUDE_CODE_DISABLE_ADVISOR_TOOL is set, and work in veda runs with the advisor on. Unset it and start a new session.' >&2; exit 2"
          }
        ]
      }
    ]
  }
}
