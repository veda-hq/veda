{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "advisorModel": "fable",
  "permissions": {
    "allow": [
      "Edit(./**)",
      "Write(./**)",
      "NotebookEdit(./**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-remote:*)",
      "Bash(git worktree list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh issue list:*)",
      "Bash(git push -u origin:*)",
      "Bash(gh pr create --draft:*)",
      "Bash(gh pr ready:*)",
      "mcp__ccd_pr__bind_pr",
      "mcp__ccd_pr__get_status",
      "mcp__ccd_pr__set_monitor",
      "mcp__Claude_Browser__get_page_text",
      "mcp__Claude_Browser__tabs_context",
      "mcp__claude-code-remote__send_message",
      "Bash(niyam review-thread *)"
    ],
    "deny": ["Bash(*--no-verify*)"],
    "ask": [
      "Bash(*git push*--force*)",
      "Bash(*git push* -f*)",
      "Bash(*git push*--for*)",
      "Bash(*git push*--mi*)",
      "Bash(*git push*--de*)",
      "Bash(*git push*--pru*)",
      "Bash(*git push* -d *)",
      "Bash(*git push* +*)",
      "Bash(*git push* :*)",
      "Bash(*git branch* -D*)",
      "Bash(*git branch*-d*-f*)",
      "Bash(*git branch*-f*-d*)",
      "Bash(*git branch* -df*)",
      "Bash(*git branch* -fd*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm update:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm update:*)",
      "Bash(yarn add:*)",
      "Bash(yarn remove:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sarathi.sh SessionStart",
            "timeout": 120
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cli=\"$HOME/.config/niyam/bin/niyam\"; [ -x \"$cli\" ] || cli=niyam; if said=$(\"$cli\" session-start 2>&1); then printf '%s\\n' \"$said\"; else printf '%s\\n' \"niyam: STOP. niyam session-start did not run here ($said), so this session cannot be given the agent identity and GitHub is locked out of it. Do not push, fetch, or run gh in this session; tell the owner.\"; fi"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sarathi.sh PreToolUse",
            "timeout": 70
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); cmd=$(printf '%s' \"$input\" | sed -nE 's/.*\"command\"[[:space:]]*:[[:space:]]*\"(([^\"\\\\]|\\\\.)*)\".*/\\1/p'); printf '%s' \"$cmd\" | grep -Eq '(^|[^[:alnum:]_-])(gh|git)([^[:alnum:]_-]|$)' || exit 0; cli=\"$HOME/.config/niyam/bin/niyam\"; [ -x \"$cli\" ] || cli=niyam; printf '%s' \"$input\" | \"$cli\" guard && exit 0; [ $? -eq 2 ] && exit 2; echo \"niyam: refused, because the niyam CLI did not run here to check this command. Do not work around it; tell the owner.\" >&2; exit 2"
          }
        ]
      }
    ]
  },
  "env": {
    "GH_TOKEN": "niyam-no-agent-token",
    "GITHUB_TOKEN": "niyam-no-agent-token",
    "GIT_CONFIG_PARAMETERS": "",
    "GIT_ASKPASS": "",
    "SSH_ASKPASS": "",
    "GIT_TERMINAL_PROMPT": "0",
    "GIT_SSH_COMMAND": "echo 'niyam: SSH is off in agent sessions; GitHub goes over HTTPS' >&2; false",
    "GIT_CONFIG_COUNT": "6",
    "GIT_CONFIG_KEY_0": "credential.helper",
    "GIT_CONFIG_VALUE_0": "",
    "GIT_CONFIG_KEY_1": "core.askpass",
    "GIT_CONFIG_VALUE_1": "",
    "GIT_CONFIG_KEY_2": "url.https://github.com/.insteadOf",
    "GIT_CONFIG_VALUE_2": "git@github.com:",
    "GIT_CONFIG_KEY_3": "url.https://github.com/.insteadOf",
    "GIT_CONFIG_VALUE_3": "ssh://git@github.com/",
    "GIT_CONFIG_KEY_4": "url.https://github.com/.insteadOf",
    "GIT_CONFIG_VALUE_4": "ssh://git@github.com:22/",
    "GIT_CONFIG_KEY_5": "url.https://github.com/.insteadOf",
    "GIT_CONFIG_VALUE_5": "ssh://git@ssh.github.com:443/"
  }
}
