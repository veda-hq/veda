{
  "testRunner": "tap",
  "plugins": ["@stryker-mutator/tap-runner"],
  "tap": {
    "testFiles": ["src/cli.test.ts", "src/exec-bits.test.ts", "src/review-size.test.ts"],
    "nodeArgs": ["--test-reporter=tap", "-r", "{{hookFile}}", "{{testFile}}"],
    "forceBail": true
  },
  "coverageAnalysis": "perTest",
  "mutate": ["src/cli.ts", "src/exec-bits.ts", "src/review-size.ts"],
  "checkers": [],
  "reporters": ["json"],
  "jsonReporter": { "fileName": "stryker-report.json" },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "incremental": false
}
