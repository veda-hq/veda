{
  "name": "veda",
  "private": true,
  "description": "Veda: generic, public tooling for repositories that coding agents work in. Nothing is published under this name; each package under packages/ is.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "check": "pnpm provenance && pnpm check:offline",
    "check:offline": "node scripts/turn.mjs --label 'veda check' -- pnpm check:offline:run",
    "check:offline:run": "pnpm -r check && pnpm test:scripts && pnpm lint && pnpm guards",
    "provenance": "node scripts/own-provenance.mjs",
    "test:scripts": "node scripts/fresh-tmpdir.mjs node --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-functions=95 --test-coverage-branches=90 '--test-coverage-include=scripts/*.mjs' '--test-coverage-exclude=scripts/*.test.mjs' scripts/*.test.mjs",
    "lint": "eslint .",
    "guards": "bash scripts/guards.sh"
  },
  "devDependencies": {
    "@sigstore/bundle": "5.0.1",
    "@sigstore/protobuf-specs": "0.5.2",
    "@sigstore/verify": "4.1.3",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/tap-runner": "10.1.1",
    "@veda-hq/agnipariksha": "0.9.1",
    "@veda-hq/dvara": "0.8.20",
    "@veda-hq/eslint-plugin-shuddhi": "0.2.0",
    "@veda-hq/niyam": "0.7.20",
    "@veda-hq/pariksha": "0.7.10",
    "@veda-hq/sarathi": "0.8.17",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0"
  }
}
