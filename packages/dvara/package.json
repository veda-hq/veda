{
  "name": "@veda-hq/dvara",
  "version": "0.5.3",
  "description": "Git hooks for repositories coding agents work in: runs each hook under a supervisor that times its stages, forwards signals and keeps one history row per run, with quiet output on success and a keep-going mode for preflights.",
  "keywords": [
    "git hooks",
    "pre-push",
    "pre-commit",
    "coding agents",
    "telemetry"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veda-hq/veda.git",
    "directory": "packages/dvara"
  },
  "homepage": "https://github.com/veda-hq/veda/tree/main/packages/dvara#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "dvara": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/supervisor.js",
    "./config": "./dist/config.js",
    "./shell/stages.sh": "./shell/stages.sh",
    "./shell/keep-going.sh": "./shell/keep-going.sh",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "shell/*.sh"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-functions=95 --test-coverage-branches=90 --test-coverage-exclude='src/**/*.test.ts' --test-coverage-include='src/**/*.ts' 'src/**/*.test.ts'",
    "smoke": "node dist/cli.js --version && node dist/cli.js shell stages",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm smoke"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "mdast-util-from-markdown": "2.0.3"
  }
}
